# Copy this file to .env and fill in ONE provider key.

# --- Option A: Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=groq/llama-3.3-70b-versatile

# --- Option B: Google AI Studio / Gemini (free tier) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini/gemini-2.0-flash

# --- Option C: FREE GPU on Kaggle (no per-request quota; weekly GPU hours)
#     Run kaggle/kaggle_llm_server.ipynb, then replace the URL and token below with the
#     values printed by its step 9 (they change every Kaggle session).
#     To switch: comment out Option A's LLM_MODEL above and uncomment these lines.
# LLM_MODEL=openai/qwen2.5:7b
# LLM_API_BASE=https://your-tunnel-name.trycloudflare.com/v1
# LLM_API_KEY=paste_the_token_printed_by_the_notebook
# LLM_REQUESTS_PER_MINUTE=0
# WORKER_CONCURRENCY=2
# LLM_TIMEOUT_SECONDS=120

# --- Option D: local model with Ollama running on your Mac (no key needed)
# LLM_MODEL=ollama/llama3.1
# OLLAMA_API_BASE=http://host.docker.internal:11434

# --- Rate limiting & background jobs (defaults shown)
# Keep LLM_REQUESTS_PER_MINUTE at or below your provider's free-tier RPM.
# LLM_REQUESTS_PER_MINUTE=10
# WORKER_CONCURRENCY=2
# JOB_MAX_ATTEMPTS=5            # then FAILED (last error kept) with a Retry button
# RETRY_BASE_SECONDS=5
# RETRY_MAX_SECONDS=300        # longer provider waits = quota exhausted -> fail fast
# RATE_LIMIT_COOLDOWN_SECONDS=60
# MATCH_MAX_ATTEMPTS=3
# MATCH_WAIT_TIMEOUT_SECONDS=45
# MAX_UPLOAD_MB=10
# API_HOST_PORT=8100           # host port for the API (http://localhost:8100/docs)

# --- Optional tuning (defaults shown)
# LLM_JSON_MODE=true
# EXTRACTION_TEMPERATURE=0
# MATCHING_TEMPERATURE=0
# EXTRACTION_MAX_ATTEMPTS=3
# LLM_TIMEOUT_SECONDS=60
# MAX_CV_CHARS=20000
